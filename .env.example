# Order emails (app/api/order) — SMTP settings for sending orders to the studio.
# Copy this file to .env.local and fill in real values. Without these the order
# form still works: it falls back to a pre-filled email (mailto:) in the browser.

# SMTP server, e.g. Gmail: smtp.gmail.com
SMTP_HOST=
SMTP_PORT=587
# For port 465 set SMTP_SECURE=true; for 587 leave it as false.
SMTP_SECURE=false
# SMTP login. For Gmail use an App Password (not your normal password):
# https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=

# Where orders are delivered (defaults to henryknez4@gmail.com if unset).
ORDER_TO_EMAIL=henryknez4@gmail.com
# From address on the order email (defaults to SMTP_USER if unset).
ORDER_FROM_EMAIL=
